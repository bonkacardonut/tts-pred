    {
      "cell_type": "code",
      "source": [
        "def xgboost_aucpr_shap():\n",
        "  # Define base XGBoost classifier\n",
        "  xgb_model = XGBClassifier(\n",
        "    objective='binary:logistic',  # Predict binary output\n",
        "    eval_metric='aucpr',          # More accurate metric for imbalanced data\n",
        "    enable_categorical=True,      # Toggle native handling of categorical variables\n",
        "    random_state=42,\n",
        "    # Added class weight\n",
        "    scale_pos_weight=9.25         # Gives more importance to the positive class\n",
        "  )\n",
        "\n",
        "  # Define random search parameter distributions\n",
        "  random_param_dist = {\n",
        "    'n_estimators': randint(50, 150),           # Number of decision trees to be built in the forest\n",
        "    'max_depth': randint(3, 8),                 # Maximum depth of each decision tree; smaller to prevent overfitting\n",
        "    'learning_rate': loguniform(0.01, 0.3),     # Values sampled with equal probability; range [0,1]\n",
        "    'subsample': loguniform(3.5e-1, 6.5e-1),    # Subsample (%) of training data; range (0,1]\n",
        "    #'subsample': uniform(0.6,0.4),\n",
        "    'colsample_bytree': uniform(0.6, 0.4),      # Subsample ratio of columns when constructing each tree\n",
        "    # Added these parameters\n",
        "    'min_child_weight': [5, 10, 20, 30],        # Restricts trees from splitting deeper (larger weight = more conservative algorithm)\n",
